# =============================================================================
# TUNNEL ENVIRONMENT (.env.tunnel)
# Loaded when APP_ENV=tunnel is set in .env.
# Used by: php artisan serve (after setting APP_ENV=tunnel in .env)
#
# This file REPLACES .env entirely — it must be a complete copy.
# Copy this to .env.tunnel and fill in your tunnel URL.
#
# Differences from .env (local):
#   APP_ENV            → tunnel     (triggers this file to load)
#   APP_URL            → https://   (your Cloudflare/ngrok URL — changes each session)
#   SESSION_SECURE_COOKIE → true    (required because tunnel runs over HTTPS)
#
# Run before starting: npm run build  (Vite dev server is not accessible via tunnel)
# =============================================================================

APP_NAME=CLMS_v1
APP_ENV=tunnel
APP_KEY=
APP_DEBUG=true

# Replace with your tunnel URL each session (Cloudflare gives a new URL each time).
APP_URL=https://your-subdomain.trycloudflare.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clms_v1
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true — tunnel is HTTPS; browser blocks cookies without Secure flag on HTTPS pages.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
