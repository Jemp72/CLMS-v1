# =============================================================================
# TUNNEL TESTING ENVIRONMENT (.env.testing-tunnel)
# Loaded when running: composer test:tunnel
# Used by: php artisan test --env=testing-tunnel
#
# This file REPLACES .env entirely — it must be a complete copy.
# Copy this to .env.testing-tunnel and fill in your tunnel URL and APP_KEY.
#
# Differences from .env.testing (local testing):
#   APP_ENV               → testing-tunnel  (triggers this file to load)
#   APP_URL               → https://        (your tunnel URL — changes each session)
#   SESSION_SECURE_COOKIE → true            (required for HTTPS)
#
# Differences from .env.tunnel (live tunnel):
#   Used only for running the test suite — not for serving the app live.
#
# Note: phpunit.xml still overrides DB, cache, session, queue, and bcrypt at runtime.
# =============================================================================

APP_NAME=CLMS_v1
APP_ENV=testing-tunnel
APP_KEY=
APP_DEBUG=true

# Replace with your current tunnel URL each session.
APP_URL=https://your-subdomain.trycloudflare.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Overridden by phpunit.xml to SQLite :memory: at runtime.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clms_v1
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true — tests run against a tunnel HTTPS URL; Secure cookie flag must match.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
