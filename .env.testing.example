# =============================================================================
# LOCAL TESTING ENVIRONMENT (.env.testing)
# Loaded when APP_ENV=testing (set automatically by phpunit.xml during tests).
# Used by: composer test
#
# This file REPLACES .env entirely — it must be a complete copy.
# Copy this to .env.testing and fill in APP_KEY.
#
# Differences from .env (local):
#   APP_ENV  → testing  (triggers this file to load)
#   APP_URL  → http://localhost (same as local, tests run internally)
#
# Note: phpunit.xml overrides several values at runtime regardless of this file:
#   DB_CONNECTION=sqlite / DB_DATABASE=:memory:  (fast, isolated, no leftover data)
#   CACHE_STORE=array                             (in-memory, reset each test run)
#   SESSION_DRIVER=array                          (in-memory, no file I/O)
#   QUEUE_CONNECTION=sync                         (jobs run immediately, no worker needed)
#   BCRYPT_ROUNDS=4                               (faster password hashing in tests)
# =============================================================================

APP_NAME=CLMS_v1
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# These DB values are overridden by phpunit.xml to use SQLite :memory:.
# Keep your real DB here as fallback if running outside phpunit.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clms_v1
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
